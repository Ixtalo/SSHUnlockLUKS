## SSHUnlockLUKS Configuration Template
## Copy this file to .env and fill in your details

# [MANDATORY] The IP address or Hostname of the remote server to be unlocked
SUL_SSH_IP=1.2.3.4

# [MANDATORY] The Dropbear SSH port used during the initramfs boot stage
SUL_SSH_PORT=22

# [MANDATORY] The standard OpenSSH port used once the OS is fully booted
# Used by the script to detect if the server is already unlocked
SUL_PROD_SSH_PORT=22

# [MANDATORY] The LUKS passphrase required to decrypt the root partition
SUL_LUKS_PASS="your_secure_passphrase_here"

# [MANDATORY] E-Mail address to notify about the outcome of each unlock attempt
SUL_MAIL_TO="admin@example.com"

# [OPTIONAL] The SSH username for the Dropbear environment (usually 'root')
SUL_SSH_USER="root"

# [OPTIONAL] Path to the SSH private key file for authentication
# SUL_SSH_KEY="/home/user/.ssh/id_rsa"

# [OPTIONAL] URL to an external CSV control file for centralized management
# IF host matches AND unlocking flag is yes THEN do the unlocking ELSE do nothing
# CSV Format: HostIP,unlocking_flag (e.g., 192.168.56.109,yes); "yes!" also overrides SUL_UNLOCK_MAX_DOWN_MINUTES
# Leave empty to disable this check
SUL_CONTROL_CSV_URL=""

# [OPTIONAL] Seconds to watch the ports after sending the passphrase (default: 120).
# Success = the production port (SUL_PROD_SSH_PORT) becomes reachable. Failure = it does not within this time:
# either the Dropbear port (SUL_SSH_PORT) stays open (passphrase rejected) or it closed but the boot is too slow.
# SUL_VERIFY_SECONDS=120

# [OPTIONAL] Send an alarm e-mail if the production SSH port stays closed for longer than this many minutes
# (one alarm per outage plus a recovery notice). Leave unset to disable.
# The cron interval must be clearly shorter than this value (e.g. every 5 minutes).
# SUL_DOWN_ALARM_MINUTES=15

# [OPTIONAL] Refuse to unlock (and send a single alarm e-mail) if the production SSH port was last seen open
# more than this many minutes ago, e.g. after an unexpected reboot or a manipulated rescue system.
# Without a recorded timestamp (first run) unlocking is NOT blocked. The cron interval must be clearly shorter
# than this value. Reset: the production port is open again, run "ssh_unlock_luks.py --reset-last-seen", or set the CSV flag to "yes!".
# SUL_UNLOCK_MAX_DOWN_MINUTES=15

# [OPTIONAL] State file for the outage tracking (default: $XDG_STATE_HOME/ssh_unlock_luks/state.json,
# i.e. ~/.local/state/ssh_unlock_luks/state.json). A "<file>.lock" next to it prevents parallel runs.
# SUL_STATE_FILE="~/.local/state/ssh_unlock_luks/state.json"

# [OPTIONAL] Sender address for notification e-mails (if unset, no From header is set and the MTA uses its system default sender)
# SUL_MAIL_FROM="ssh-unlock-luks@example.com"

# [OPTIONAL] Subject prefix for notification e-mails
# SUL_MAIL_SUBJECT="SSHUnlockLUKS: unlock attempt result"
